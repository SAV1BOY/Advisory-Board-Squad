# ============================================================================
# ADVISORY BOARD SQUAD — SWIPE FILE CONFIGURATION
# ============================================================================
# Governs the curation, sourcing, tagging, and quality standards for all
# swipe file materials used by advisory board agents. Swipe files are
# real-world examples of exceptional (and instructively poor) board-level
# communications, decisions, and artifacts.
#
# Version: 2.0.0
# Last updated: 2026-03-10
# ============================================================================

swipe_sources:

  - id: annual_shareholder_letters
    description: "Annual letters from founders and CEOs to shareholders — the gold standard of strategic communication."
    storage_path: swipe/shareholder-letters/
    examples:
      - "Buffett annual letters (Berkshire Hathaway, 1977-present) — capital allocation philosophy"
      - "Bezos annual letters (Amazon, 1997-2020) — Day 1 thinking, long-term orientation"
      - "Zuckerberg IPO letter (Facebook/Meta, 2012) — mission-driven governance"
      - "Hastings culture deck evolution (Netflix, 2009-2022) — radical transparency"
      - "Dimon annual letters (JPMorgan, 2005-present) — operational rigor"
      - "Nadella annual letters (Microsoft, 2014-present) — transformation narrative"
      - "Cook annual letters (Apple, 2012-present) — values integration"
    selection_criteria:
      - Demonstrates clear strategic thinking communicated to non-expert audience
      - Includes candid discussion of mistakes and what was learned
      - Shows how long-term principles guide short-term decisions
      - Reveals the leader's mental models explicitly or implicitly

  - id: iconic_strategy_memos
    description: "Internal strategy memos that shaped company direction — the art of written strategic thought."
    storage_path: swipe/strategy-memos/
    examples:
      - "Amazon 6-pager format and examples — narrative over slides"
      - "Dalio Principles memo (Bridgewater, original internal version) — codified decision-making"
      - "Grove 'Only the Paranoid Survive' strategic inflection memos (Intel) — pivot reasoning"
      - "Ballmer 'One Microsoft' memo — organizational transformation"
      - "Dorsey 'What Twitter needs to do' memo — simplification and focus"
      - "Collison brothers early Stripe strategy memos — market creation"
      - "Chesky 'Don't F*** Up the Culture' memo (Airbnb) — culture as strategy"
    selection_criteria:
      - Demonstrates rigorous problem definition before solution
      - Shows clear option generation and trade-off analysis
      - Includes the reasoning, not just the conclusion
      - Became a turning point in company history (positive or negative)

  - id: board_deck_gallery
    description: "Board presentation materials that demonstrate effective information design and decision framing."
    storage_path: swipe/board-decks/
    examples:
      - "Sequoia Capital board deck template — concise, metrics-first"
      - "a16z board meeting format — structured decision sections"
      - "Y Combinator board meeting guide for early-stage — minimal viable governance"
      - "First Round Capital board deck best practices — pre-read design"
      - "Benchmark Capital investment memo format — thesis-driven"
    selection_criteria:
      - Presents complex information in scannable, decision-ready format
      - Separates information from recommendation from decision
      - Includes forward-looking metrics, not just backward-looking
      - Respects board member time (< 30 minutes to review)

  - id: crisis_cases
    description: "Real-world crisis response cases — what worked, what failed, and why."
    storage_path: swipe/crisis-playbooks/
    examples:
      - "Johnson & Johnson Tylenol recall (1982) — gold standard crisis response"
      - "Boeing 737 MAX crisis (2018-2019) — failure of governance and culture"
      - "Wells Fargo accounts scandal (2016) — incentives-driven crisis"
      - "Uber cultural crisis and CEO transition (2017) — culture as existential risk"
      - "Theranos collapse — governance failure and whistleblower suppression"
      - "FTX collapse — absence of board governance"
      - "Volkswagen emissions scandal — engineering culture override of ethics"
      - "Patagonia ownership transfer — values-driven irreversible decision"
    selection_criteria:
      - Includes both the crisis and the response with documented outcomes
      - Shows board-level decision-making under pressure
      - Reveals systemic causes, not just proximate triggers
      - Contains lessons applicable across industries

  - id: hiring_scorecard_library
    description: "Executive hiring scorecards and assessment frameworks from high-performance organizations."
    storage_path: swipe/hiring-scorecards/
    examples:
      - "Topgrading scorecard examples — competency-based hiring"
      - "Google VP hiring rubric (pre-2020) — structured interview scoring"
      - "Bridgewater 'baseball card' assessments — radical transparency in evaluation"
      - "Netflix 'keeper test' framework — retention as continuous hiring decision"
      - "Stripe executive hiring process documentation — technical leadership"
      - "SpaceX mission-critical role scorecards — high-consequence hiring"
    selection_criteria:
      - Defines measurable competencies, not vague qualities
      - Includes anti-patterns and red flags, not just green flags
      - Shows calibration method across interviewers
      - Includes post-hire validation data where available

  - id: negotiation_and_terms_library
    description: "Partnership terms, deal structures, and negotiation case studies at board level."
    storage_path: swipe/partnership-deals/
    examples:
      - "Standard venture term sheet annotations — clause-by-clause analysis"
      - "Strategic partnership term frameworks — equity vs. revenue share vs. license"
      - "M&A deal structure case studies — earnout, holdback, and integration terms"
      - "Joint venture governance structures — decision rights in shared entities"
      - "Technology licensing deal frameworks — IP protection and commercialization"
      - "Celebrity/influencer partnership structures — alignment and exit mechanisms"
    selection_criteria:
      - Includes term-by-term analysis with rationale for each
      - Shows negotiation leverage points and walk-away conditions
      - Includes post-deal outcomes where available
      - Covers both successful and failed deal structures

  - id: sustainability_tradeoffs_cases
    description: "Cases where companies navigated sustainability, ethics, and profit trade-offs at board level."
    storage_path: swipe/culture-docs/
    examples:
      - "Patagonia 'Earth is our only stakeholder' — governance restructuring for mission"
      - "Unilever Sustainable Living Plan — board-level sustainability integration"
      - "Interface 'Mission Zero' — industrial company sustainability transformation"
      - "Costco stakeholder capitalism approach — wage and benefit decisions"
      - "CVS tobacco withdrawal decision — revenue sacrifice for brand alignment"
      - "BlackRock stakeholder capitalism letters — investor perspective on purpose"
      - "Ben & Jerry's acquisition terms — preserving mission through M&A"
    selection_criteria:
      - Shows explicit board deliberation on profit vs. mission trade-offs
      - Includes financial impact data, not just narrative
      - Demonstrates second-order effects (positive and negative)
      - Reveals how governance structures enabled or constrained the decision

# ============================================================================
# CURATION RULES — Standards for what enters and stays in the swipe files
# ============================================================================

curation_rules:

  - id: include_context_outcome
    description: "Every swipe entry must include the context (what was happening when the artifact was created) and the outcome (what happened as a result)."
    enforcement: mandatory
    rationale: "An artifact without context is trivia. An artifact without outcome is untested theory."
    validation: "Each entry must have 'Context' and 'Outcome' sections with minimum 100 words each."

  - id: tag_by_domain_and_framework
    description: "Every swipe entry must be tagged with its primary domain (strategy, capital, people, culture, risk, partnerships, governance) and the frameworks it demonstrates."
    enforcement: mandatory
    rationale: "Tags enable retrieval by domain when agents need reference material during task execution."
    tag_taxonomy:
      domains:
        - strategy
        - capital
        - people
        - culture
        - risk
        - partnerships
        - governance
        - operations
        - ethics
      frameworks: "Reference by filename from frameworks/ directory."
    validation: "Minimum one domain tag and one framework tag per entry."

  - id: include_what_failed
    description: "Swipe files must include examples of failure, not just success. For every three success examples, include at least one instructive failure."
    enforcement: mandatory
    rationale: "Survivorship bias is the enemy of good judgment. Studying failure teaches more than studying success."
    ratio: "3:1 success to failure minimum. 2:1 preferred."
    validation: "Each swipe source category must contain entries tagged 'failure_case' or 'cautionary_example'."

  - id: prefer_primary_sources
    description: "Use original documents, direct quotes, and first-hand accounts over secondhand summaries, journalist interpretations, or book paraphrases."
    enforcement: preferred
    rationale: "Primary sources preserve nuance. Summaries introduce the summarizer's bias."
    priority_order:
      1: "Original document (memo, letter, filing)"
      2: "Direct quote from author in interview or testimony"
      3: "Case study with cited primary sources"
      4: "Book excerpt with full attribution"
      5: "Reputable journalism with named sources"
    validation: "Source type must be declared in metadata. Priority 1-3 sources preferred."

  - id: never_include_copyrighted_verbatim
    description: "Never reproduce copyrighted material verbatim. Summarize, excerpt within fair use, or reference with citation."
    enforcement: mandatory
    rationale: "Legal compliance is non-negotiable. The swipe file teaches principles, not piracy."
    permitted:
      - "Short excerpts (< 300 words) with full attribution"
      - "Summaries of key ideas with source citation"
      - "Structural analysis of document format without reproducing content"
      - "Publicly available documents (SEC filings, open letters, public speeches)"
    prohibited:
      - "Full reproduction of copyrighted books, articles, or reports"
      - "Paywalled content reproduced in full"
      - "Proprietary frameworks reproduced without license"
    validation: "Every entry must include a 'source_type' field indicating copyright status."

# ============================================================================
# SWIPE FILE METADATA STANDARDS
# ============================================================================

metadata_standards:
  required_fields:
    - title
    - source
    - source_type          # primary | secondary | tertiary
    - copyright_status     # public_domain | fair_use_excerpt | creative_commons | proprietary_summary
    - domain_tags          # from curation_rules.tag_by_domain_and_framework.tag_taxonomy.domains
    - framework_tags       # framework filenames
    - date_created         # when the original artifact was created
    - date_curated         # when it was added to the swipe file
    - context              # what was happening when this was created (min 100 words)
    - outcome              # what happened as a result (min 100 words)
    - key_lessons          # 3-5 bullet points
    - success_or_failure   # success | failure | mixed
    - curated_by           # which agent curated this entry

  optional_fields:
    - related_entries      # links to other swipe entries
    - related_frameworks   # additional framework references
    - industry             # industry vertical
    - company_stage        # seed | series_a | growth | public | turnaround
    - decision_type        # type_1_irreversible | type_2_reversible
    - board_involvement    # how the board was involved in the decision

# ============================================================================
# MAINTENANCE CADENCE
# ============================================================================

maintenance:
  review_frequency: quarterly
  review_agent: governance-clerk
  approver: board-chair
  max_age_before_review: 365_days
  archive_policy: "Entries older than 3 years without re-validation move to archive/. Never delete."
  growth_target: "Add minimum 5 new curated entries per quarter across categories."
  quality_audit: "Annual audit of all entries against curation_rules. Non-compliant entries get 30 days to remediate or archive."
